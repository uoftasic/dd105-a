`verilator_config
// DD105-A: what the waves leave out. uvm.mk passes this file to every build
// with TRACE=1 (the default) unless TRACE_PKGS=1.
//
// $dumpvars with no scope dumps everything that is traced, and on this
// simulator that includes the static variables of the UVM library's
// packages: six uvm_pkg scopes in every viewer, above the design. It would
// also include the package variable that says which planted bug is on, which
// gives a mystery bug away. So no package is traced; the design, its
// interfaces and the top module are.
tracing_off -file "third_party/uvm/src/*"
tracing_off -scope "*_pkg*"
// The router's faulty build reads +BUG in an initial block named bug_switch,
// whose local "id" holds the bug's number.
tracing_off -scope "*bug_switch*"
